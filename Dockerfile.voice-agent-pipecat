# Worker de voz (Pipecat) — motor de orquestração da ponte áudio/LLM,
# substituindo o bridge TS (workers/voice-agent/audioSocketBridge.ts). Único
# serviço Python do monorepo — os demais workers (Dockerfile.worker,
# Dockerfile.voice-agent) são todos Node/tsx. Single-stage, mesmo espírito
# dos outros Dockerfiles daqui: sem etapa de build separada.
FROM python:3.12-slim

WORKDIR /app

LABEL org.opencontainers.image.source="https://github.com/melgarafael/DeskcommCRM" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.title="DeskcommCRM voice-agent-pipecat"

COPY workers/voice-agent-pipecat/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY workers/voice-agent-pipecat/ ./

CMD ["python", "main.py"]
